# Stage 1: deps
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat python3 make g++ pango-dev jpeg-dev giflib-dev librsvg-dev
WORKDIR /app
COPY package.json package-lock.json* turbo.json ./
COPY apps/bot/package.json ./apps/bot/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
RUN npm ci

# Stage 2: builder
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat python3 make g++ pango-dev jpeg-dev giflib-dev librsvg-dev
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx turbo run build --filter=@chiro/bot

# Stage 3: runner
FROM node:20-alpine AS runner
RUN apk add --no-cache pango jpeg giflib librsvg
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 botuser
COPY --from=builder /app/apps/bot/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/bot/package.json ./
USER botuser
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', (r) => r.statusCode === 200 ? process.exit(0) : process.exit(1))"
CMD ["node", "dist/index.js"]
